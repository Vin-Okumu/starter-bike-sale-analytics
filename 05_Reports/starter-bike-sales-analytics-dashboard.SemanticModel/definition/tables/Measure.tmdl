table Measure
	lineageTag: 92e454ca-1bde-495e-8123-44b2c1a9d249

	measure 'Total Revenue' = SUM('Sales'[Revenue])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c92d2af0-da48-494f-b1e8-8301299bec2a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' = SUM('Sales'[Profit])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cc60b0bc-0ade-4d94-9e6f-d9ad028871f2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Tax Due' = SUM('Sales'[Tax Due])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a5b87265-1013-46b7-a5e2-63d2bc3371f5

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Orders' = DISTINCTCOUNT('Sales'[Order ID])
		formatString: 0
		lineageTag: f2a88b91-2fcb-448a-abb1-0f46230d0328

	measure Customers = DISTINCTCOUNT('Sales'[Customer ID])
		formatString: 0
		lineageTag: adc5af65-5b94-4cd2-8f54-20557144e12e

	measure 'Quantity Sold' =
			CALCULATE(
			    SUM('Sales'[Order Quantity]),
			    'Sales'[Order Status] <> "Cancelled"
			)
		formatString: 0
		lineageTag: 35572f62-8a7c-4281-9a4a-555bbd4c9533

	measure 'Average Order Value' =
			DIVIDE(
			    [Total Revenue],[Total Orders]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d93346ce-08ee-424d-a9b9-f043ee6f3b93

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Shipped Order' =
			(
			    CALCULATE(
			    COUNTROWS('Sales'),
			    'Sales'[Order Status] = "Shipped")
			)
		formatString: 0
		lineageTag: 381f015b-3697-4a32-8627-5ba3d2f2e940

	measure 'Total Cancelled Order' =
			
			CALCULATE(
			    COUNTROWS('Sales'),
			    'Sales'[Order Status] = "Cancelled")
		formatString: 0
		lineageTag: c59dfe7b-13cf-44cc-98d9-3cb2c9ac6116

	measure 'Total Orders Under Process' =
			
			CALCULATE(
			    COUNTROWS('Sales'),
			    'Sales'[Order Status] = "Processing")
		formatString: 0
		lineageTag: 4dfca89e-a08f-472d-b1a8-cf1bbe387250

	measure 'Shipped Orders' =
			DIVIDE (
			    [Total Shipped Order],[All Orders])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 939e76b0-4f41-405b-85c1-2f886e738ea3

	measure 'Under Processing' =
			DIVIDE (
			    [Total Orders Under Process],[All Orders])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8ea6bee5-9f83-4a40-a35f-71b09832bd33

	measure 'Cancelled Orders' =
			DIVIDE (
			    [Total Cancelled Order],[All Orders])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 086289e4-7bce-44a7-8601-c127b98adb0e

	measure 'All Orders' = DISTINCTCOUNT('Sales'[Product ID])
		formatString: 0
		lineageTag: b23e3a51-d5c2-4391-a591-d2526bfb2801

	measure 'Taxable Sale' =
			CALCULATE(
			    COUNTROWS('Sales'),
			    'Sales'[Tax Due] > 0)
		formatString: 0
		lineageTag: b383f29e-43b7-41de-b800-a8cf728884f2

	measure 'Taxable Sale Percent' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('Sales'),'Sales'[Tax Due] > 0),
			        CALCULATE(
			            COUNTROWS('Sales'),'Sales'[Product ID]
			        )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b79123a6-2c75-4f8b-b059-25c27676f957

	measure 'Tax Proportion' =
			DIVIDE(
			    [Total Tax Due],[Total Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d2bb6933-4404-48f3-a675-29f807d55466

	measure 'Net Revenue' = [Total Revenue] - [Total Tax Due]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9a241e62-06bf-40d4-bdfd-2b0be1b76552

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Margin' =
			DIVIDE(
			    [Total Profit],
			    [Total Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8aff2d19-8034-4b03-8cd0-99afb3a9e665

	partition Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measure = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measure", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Measure"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

