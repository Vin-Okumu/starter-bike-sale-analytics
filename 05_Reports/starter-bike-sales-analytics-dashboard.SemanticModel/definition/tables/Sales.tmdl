	column Revenue =
			IF(
			    NOT('Sales'[Order Status] = "Cancelled"),
			    'Sales'[Retail Price] * 'Sales'[Order Quantity],0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 28a4c735-3691-4696-8077-55ac1f9a8d15
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Tax Due' = ```
			IF(
			    'Sales'[Revenue] > 2000, 
			    'Sales'[Revenue] * 0.05, 0 )
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7d85134c-495a-4d30-88b1-cf648bd4eaba
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Customer Bill' = ```
			'Sales'[Revenue] + 
			'Sales'[Tax Due]
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f55f5ce3-4bf4-43fa-b224-dd2d89a0011f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Profit =
			IF(
			    NOT('Sales'[Order Status] = "Cancelled"),
			    (('Sales'[Retail Price] -
			    'Sales'[Wholesale Price]) * 'Sales'[Order Quantity]),0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: daf34465-4fab-482b-a997-879df0faf252
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Order Value' = 'Sales'[Retail Price] * 'Sales'[Order Quantity]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2aca0600-2a98-4e62-86bd-322f9bf74088
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Tax Proportion' =
			DIVIDE(
			    [Tax Due],[Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a47bdd36-00ff-495d-bc5e-6e3fe58e5080
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

