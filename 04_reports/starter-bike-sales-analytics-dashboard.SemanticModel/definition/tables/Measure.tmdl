table Measure
	lineageTag: 92e454ca-1bde-495e-8123-44b2c1a9d249

	/// Revenue from shipped and processing lines, excluding tax.
	measure 'Total Revenue' = SUM ( Sales[Revenue] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: c92d2af0-da48-494f-b1e8-8301299bec2a

	/// Gross profit from shipped and processing lines.
	measure 'Total Profit' = SUM ( Sales[Profit] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: cc60b0bc-0ade-4d94-9e6f-d9ad028871f2

	/// 5% tax on fulfilled lines worth more than $2,000.
	measure 'Total Tax Due' = SUM ( Sales[Tax Due] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: a5b87265-1013-46b7-a5e2-63d2bc3371f5

	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: d93346ce-08ee-424d-a9b9-f043ee6f3b93

	/// All order lines, including cancelled.
	measure 'Order Lines' = COUNTROWS ( Sales )
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: ea465748-0437-541e-99b5-75d5ed22bbbb

	/// Shipped plus processing lines.
	measure 'Fulfilled Lines' = CALCULATE ( COUNTROWS ( Sales ), Sales[Order Status] <> "Cancelled" )
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: d617d564-a750-5a97-9581-ee429d3d8535

	measure 'Gross Margin %' = DIVIDE ( [Total Profit], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 51ab0a56-325e-5437-ab65-f6d831c0ccac

	/// Value of all order lines, including cancelled.
	measure 'Order Value' = SUM ( Sales[Order Value] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: fc232109-2bd9-52eb-9cd8-bfdcc4cc71ea

	measure 'Shipped Value' = CALCULATE ( [Order Value], Sales[Order Status] = "Shipped" )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 86ad7f54-b036-5b66-b25b-4bb38582cbcb

	measure 'Processing Value' = CALCULATE ( [Order Value], Sales[Order Status] = "Processing" )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 83ea183b-1448-529b-80a1-dd7ae786db54

	/// Order value lost to cancellations.
	measure 'Cancelled Value' = CALCULATE ( [Order Value], Sales[Order Status] = "Cancelled" )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 2132668d-9778-5ed9-93f4-fe47156ccc4a

	/// Revenue plus tax added to the customer's bill. Replaces [Net Revenue].
	measure 'Customer Billings' = SUM ( Sales[Customer Bill] )
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 163b3cab-3f66-5203-9385-7503afc3bd0c

	measure 'Shipped Line %' = DIVIDE ( [Total Shipped Order], [Order Lines] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 5c3fe40d-fd88-5023-9375-873f16cdd199

	measure 'Processing Line %' = DIVIDE ( [Total Orders Under Process], [Order Lines] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: de26f775-adf6-535b-9303-2fb8e3b60816

	measure 'Cancelled Line %' = DIVIDE ( [Total Cancelled Order], [Order Lines] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 4d90c2ca-68ba-5665-ade9-554ea92722d1

	measure 'Taxable Lines' = CALCULATE ( COUNTROWS ( Sales ), Sales[Tax Due] > 0 )
		formatString: #,0
		displayFolder: 5 Tax
		lineageTag: 48361e56-2f80-5a0d-98ca-2fdaea719483

	/// Share of fulfilled lines worth more than $2,000.
	measure 'Taxable Line %' = DIVIDE ( [Taxable Lines], [Fulfilled Lines] )
		formatString: 0.0%
		displayFolder: 5 Tax
		lineageTag: c220a7c1-b421-5d8d-9ca5-beae3bf9189a

	measure 'Tax % of Revenue' = DIVIDE ( [Total Tax Due], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 5 Tax
		lineageTag: eda5a47b-bd2e-50b2-a355-0511db3435c2

	/// Average revenue per fulfilled order line.
	measure 'Avg Line Value' = DIVIDE ( [Total Revenue], [Fulfilled Lines] )
		formatString: \$#,0
		displayFolder: 3 Products
		lineageTag: a0c6ac2b-9b88-5dd4-ac8f-a5d77d523bd5

	measure 'Category Revenue Share' = DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( Sales[Product Category] ) ) )
		formatString: 0.0%
		displayFolder: 3 Products
		lineageTag: 95b64b7e-ffc6-5930-87ce-64f0c4f8bd80

	measure 'Categories Selling' = COUNTROWS ( FILTER ( VALUES ( Sales[Product Category] ), [Total Revenue] > 0 ) )
		formatString: #,0
		displayFolder: 3 Products
		lineageTag: 563d0f65-0607-5d30-a3c3-2b6a40659609

	measure 'Top Category' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Sales[Product Category] ), "@r", [Total Revenue] ), [@r], DESC )
			RETURN MAXX ( t, Sales[Product Category] )
		displayFolder: 3 Products
		lineageTag: 51b74a4b-ee89-5a41-be85-38a036898845

	measure 'Top Category Share' =
			VAR c = [Top Category]
			RETURN
			    DIVIDE (
			        CALCULATE ( [Total Revenue], Sales[Product Category] = c ),
			        CALCULATE ( [Total Revenue], REMOVEFILTERS ( Sales[Product Category] ) )
			    )
		formatString: 0.0%
		displayFolder: 3 Products
		lineageTag: 209cede1-2e47-51b3-a018-81b5f47e9ce1

	measure 'Top Category Share PY' =
			VAR c = [Top Category]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            CALCULATE ( [Total Revenue], Sales[Product Category] = c ),
			            CALCULATE ( [Total Revenue], REMOVEFILTERS ( Sales[Product Category] ) )
			        ),
			        SAMEPERIODLASTYEAR ( 'Date'[Date] )
			    )
		formatString: 0.0%
		displayFolder: 2 Comparisons
		lineageTag: 75666718-6565-5c8d-a9e0-fcd91ce63cf0

	measure 'Top Model' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Sales[Product Name] ), "@r", [Total Revenue] ), [@r], DESC )
			RETURN MAXX ( t, Sales[Product Name] )
		displayFolder: 3 Products
		lineageTag: 39f45d03-4822-5121-bfd2-8c7eccab78bf

	measure 'Top Model Revenue' =
			VAR p = [Top Model]
			RETURN CALCULATE ( [Total Revenue], Sales[Product Name] = p )
		formatString: \$#,0
		displayFolder: 3 Products
		lineageTag: 3d87fc3b-0bc0-5c75-bd66-00c81f5a49e2

	measure 'Top Model Revenue PY' =
			VAR p = [Top Model]
			RETURN CALCULATE ( [Revenue PY], Sales[Product Name] = p )
		formatString: \$#,0
		displayFolder: 2 Comparisons
		lineageTag: 668f2ef3-7926-5ad4-8d49-53353686c5d6

	measure 'PayPal Line Value' = CALCULATE ( [Avg Line Value], Sales[Payment Method] = "PayPal" )
		formatString: \$#,0
		displayFolder: 3 Products
		lineageTag: f021243d-6b5f-5ff5-9b14-ad7f572b143d

	measure 'Card Line Value' = CALCULATE ( [Avg Line Value], Sales[Payment Method] = "Credit Card" )
		formatString: \$#,0
		displayFolder: 3 Products
		lineageTag: f95fe084-3bd8-5cb5-a03b-1489d4d4f8c7

	measure 'PayPal Premium %' = DIVIDE ( [PayPal Line Value] - [Card Line Value], [Card Line Value] )
		formatString: 0.0%
		displayFolder: 3 Products
		lineageTag: ab6359a4-262c-5f1c-b82c-e3e63a63e549

	measure 'Top Cancel Category' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Sales[Product Category] ), "@v", [Cancelled Value] ), [@v], DESC )
			RETURN IF ( [Cancelled Value] > 0, MAXX ( t, Sales[Product Category] ) )
		displayFolder: 4 Orders
		lineageTag: 2a023aec-93cd-5c05-aa9f-881d84c21780

	measure 'Top Cancel Category Rate' =
			VAR c = [Top Cancel Category]
			RETURN CALCULATE ( [Cancelled Line %], Sales[Product Category] = c )
		formatString: 0.0%
		displayFolder: 4 Orders
		lineageTag: 232efe4a-e1a9-5610-9524-a4acdd6158c8

	measure 'Top Cancel Category Rate PY' =
			VAR c = [Top Cancel Category]
			RETURN CALCULATE ( [Cancelled Line %], Sales[Product Category] = c, SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: 2 Comparisons
		lineageTag: 4c1b3a16-3c88-531b-8cd2-499cbde1df10

	measure 'Top Cancel Category Value Share' =
			VAR c = [Top Cancel Category]
			RETURN DIVIDE ( CALCULATE ( [Cancelled Value], Sales[Product Category] = c ), [Cancelled Value] )
		formatString: 0.0%
		displayFolder: 4 Orders
		lineageTag: d61d208e-3749-5c38-80a0-5dfb631615e1

	measure 'Top Tax Month' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@t", [Total Tax Due] ), [@t], DESC )
			RETURN MAXX ( t, 'Date'[Month] )
		displayFolder: 5 Tax
		lineageTag: d04727f6-c3ae-5a71-963c-1ce0005e262a

	measure 'Top Tax Month Value' =
			VAR mth = [Top Tax Month]
			RETURN CALCULATE ( [Total Tax Due], 'Date'[Month] = mth )
		formatString: \$#,0
		displayFolder: 5 Tax
		lineageTag: 2b391993-aa8e-53d3-aa06-9dd7000ee732

	measure 'Top Tax Month Value PY' =
			VAR mth = [Top Tax Month]
			RETURN CALCULATE ( [Tax Due PY], 'Date'[Month] = mth )
		formatString: \$#,0
		displayFolder: 2 Comparisons
		lineageTag: c1e3bccb-8f41-5c7a-8e29-cdc80076aad3

	measure 'Top Tax Category' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Sales[Product Category] ), "@t", [Total Tax Due] ), [@t], DESC )
			RETURN MAXX ( t, Sales[Product Category] )
		displayFolder: 5 Tax
		lineageTag: 9c192ce9-9954-557a-b4f6-86071e67794b

	measure 'Top Tax Category Share' =
			VAR c = [Top Tax Category]
			RETURN DIVIDE ( CALCULATE ( [Total Tax Due], Sales[Product Category] = c ), [Total Tax Due] )
		formatString: 0.0%
		displayFolder: 5 Tax
		lineageTag: bc6de562-3e46-5bdb-a49a-2ca4524d0417

	/// Text such as 'Q1 2022' for KPI labels.
	measure 'Prior Period Label' =
			VAR y = SELECTEDVALUE ( 'Date'[Year], MAX ( 'Date'[Year] ) )
			RETURN "Q1 " & ( y - 1 )
		displayFolder: 2 Comparisons
		lineageTag: 21ca55f8-e17c-53a8-a3f2-cbb4585d6147

	measure 'Revenue PY' = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: 2 Comparisons
		lineageTag: 81b87846-07f7-549a-812b-a8aa1ca58755

	measure 'Revenue YoY %' =
			VAR py = [Revenue PY]
			RETURN DIVIDE ( [Total Revenue] - py, py )
		formatString: 0.0%
		displayFolder: 2 Comparisons
		lineageTag: 5fb29221-89e7-58af-85ed-2c37532f740e

	measure 'Revenue vs PY Label' =
			VAR cur = [Total Revenue]
			VAR py = [Revenue PY]
			VAR chg = DIVIDE ( cur - py, py )
			RETURN
			    IF (
			        ISBLANK ( py ),
			        "No prior-year data",
			        IF ( chg >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs " & [Prior Period Label] & " (" & IF ( ABS ( py ) >= 1000, FORMAT ( py / 1000, "$#,0.0" ) & "K", FORMAT ( py, "$#,0" ) ) & ")"
			    )
		displayFolder: 2 Comparisons
		lineageTag: bdebc8c1-d08d-5bfa-82e3-7ddf47b414a4

	measure 'Revenue vs PY Color' =
			VAR cur = [Total Revenue]
			VAR py = [Revenue PY]
			VAR chg = DIVIDE ( cur - py, py )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( py ) || FALSE (), "#4B5563", chg > 0, "#15803D", chg < 0, "#B91C1C", "#4B5563" )
		displayFolder: 7 Formatting
		lineageTag: d43b7f5d-f4ce-5602-8b79-a36567abaee1

	measure 'Gross Profit PY' = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
