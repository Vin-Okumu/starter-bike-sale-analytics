	measure 'Gross Margin PY' = CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: 2 Comparisons
		lineageTag: 8918f729-413d-586a-9d58-9fc4ef9ee16b

	measure 'Gross Margin Change pts' =
			VAR py = [Gross Margin PY]
			RETURN IF ( NOT ISBLANK ( py ), ( [Gross Margin %] - py ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Comparisons
		lineageTag: 2e13aee8-1541-5675-965c-514441c831e6

	measure 'Gross Margin vs PY Label' =
			VAR cur = [Gross Margin %]
			VAR py = [Gross Margin PY]
			VAR chg = ( cur - py ) * 100
			RETURN
			    IF (
			        ISBLANK ( py ),
			        "No prior-year data",
			        IF ( ABS ( chg ) < 0.5, "≈ flat", IF ( chg > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( chg ), "0.0" ) & " pts" ) & " vs " & [Prior Period Label] & " (" & FORMAT ( py, "0.0%" ) & ")"
			    )
		displayFolder: 2 Comparisons
		lineageTag: 22d616bd-247b-5516-99ae-2a93bf15ebcb

	measure 'Gross Margin vs PY Color' =
			VAR cur = [Gross Margin %]
			VAR py = [Gross Margin PY]
			VAR chg = ( cur - py ) * 100
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( py ) || ABS ( chg ) < 0.5, "#4B5563", chg > 0, "#15803D", chg < 0, "#B91C1C", "#4B5563" )
		displayFolder: 7 Formatting
		lineageTag: bd046de8-3df2-5e80-8b5b-d5c40cefeed5

