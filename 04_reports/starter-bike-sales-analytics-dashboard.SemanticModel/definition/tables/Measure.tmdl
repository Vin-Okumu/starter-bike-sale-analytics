		lineageTag: d87bd006-4c42-512e-9262-85cbbc35d179

	measure 'Title Cancelled Models' =
			
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR _models =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( Sales[Product Name] ), Sales[Product Category] = c ),
			            "@v", CALCULATE ( [Cancelled Value], Sales[Product Category] = c )
			        ),
			        [@v] > 0
			    )
			VAR n = COUNTROWS ( _models )
			VAR topP = MAXX ( TOPN ( 1, _models, [@v], DESC ), Sales[Product Name] )
			VAR word =
			    SWITCH ( n, 1, "One", 2, "Two", 3, "Three", 4, "Four", 5, "Five", 6, "Six", 7, "Seven", 8, "Eight", 9, "Nine", n & "" )
			VAR catModel = SUBSTITUTE ( c, "Bikes", "Bike" )
			VAR catShort = SUBSTITUTE ( c, " Bikes", "" )
			RETURN
			    IF (
			        ISBLANK ( c ),
			        "No orders were cancelled",
			        word & " " & catModel & " models account for every " & catShort
			            & " cancellation; start with " & topP
			    )
		displayFolder: 6 Titles
		lineageTag: 648af4a5-5406-55db-9c2b-04c35ad76a61

