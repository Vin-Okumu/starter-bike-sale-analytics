	measure 'Title Revenue Trend' =
			VAR py = [Revenue PY]
			VAR chg = [Revenue YoY %]
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@r", [Total Revenue] ), [@r], DESC )
			VAR bestMonth = MAXX ( t, 'Date'[Month] )
			VAR bestValue = MAXX ( t, [@r] )
			VAR m = FILTER ( ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@c", [Total Revenue], "@p", [Revenue PY] ), NOT ISBLANK ( [@c] ) )
			VAR beatAll = COUNTROWS ( m ) > 1 && COUNTROWS ( FILTER ( m, [@c] > [@p] ) ) = COUNTROWS ( m )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), bestMonth & " was the best month at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) ) & " (no prior-year data to compare)",
			        beatAll, "Revenue beat " & [Prior Period Label] & " in every month; " & bestMonth & " peaked at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) ),
			        "Revenue " & IF ( chg >= 0, "up ", "down " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs " & [Prior Period Label] & "; " & bestMonth & " was the best month at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) )
			    )
		displayFolder: 6 Titles
		lineageTag: e8f60c96-71b3-5de6-8723-682071aa0544

	measure 'Title Category Revenue' =
			VAR c = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Category Share], ALLSELECTED ( Sales[Product Category] ) )
			RETURN c & " earned " & FORMAT ( s, "0%" ) & " of revenue"
		displayFolder: 6 Titles
		lineageTag: 344c64e1-780a-5baa-90d5-6790c77be02e

	measure 'Title Cancellations' =
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Cancel Category Value Share], ALLSELECTED ( Sales[Product Category] ) )
			VAR v = CALCULATE ( [Cancelled Value], ALLSELECTED ( Sales[Product Category] ) )
			RETURN
			    IF (
			        v > 0,
			        c & " caused " & FORMAT ( s, "0%" ) & " of the " & IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) ) & " lost to cancellations",
			        "No order value was lost to cancellations"
			    )
		displayFolder: 6 Titles
		lineageTag: 7d013b00-c41a-5bdc-8f53-3fd8d04c05d3

	measure 'Title Order Status' =
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR r = CALCULATE ( [Top Cancel Category Rate], ALLSELECTED ( Sales[Product Category] ) )
			RETURN c & ": " & FORMAT ( r, "0%" ) & " of order lines cancelled"
		displayFolder: 6 Titles
		lineageTag: ed3ad67b-51f1-5c3e-b041-5513931992b8

	measure 'Title Top Model' =
