	measure 'Title Margin Leaders' =
			
			VAR avgM = [Gross Margin %]
			VAR leaders =
			    ADDCOLUMNS (
			        FILTER (
			            VALUES ( Sales[Product Category] ),
			            [Total Revenue] > 0 && [Gross Margin %] >= avgM + 0.05
			        ),
			        "@n", SUBSTITUTE ( SUBSTITUTE ( Sales[Product Category], " Bikes", "" ), "Bmx", "BMX" ),
			        "@r", [Total Revenue],
			        "@m", [Gross Margin %]
			    )
			VAR k = COUNTROWS ( leaders )
			VAR ranked = ADDCOLUMNS ( leaders, "@i", RANKX ( leaders, [@r], , DESC, Skip ) )
			VAR firstNames = CONCATENATEX ( FILTER ( ranked, [@i] < k ), [@n], ", ", [@r], DESC )
			VAR lastName = MAXX ( FILTER ( ranked, [@i] = k ), [@n] )
			VAR names = IF ( k = 1, lastName, firstNames & " and " & lastName )
			VAR minM = MINX ( leaders, [@m] )
			VAR maxM = MAXX ( leaders, [@m] )
			VAR mText = IF ( ROUND ( minM, 2 ) = ROUND ( maxM, 2 ), FORMAT ( minM, "0%" ), FORMAT ( minM, "0%" ) & "–" & FORMAT ( maxM, "0%" ) )
			VAR share = DIVIDE ( SUMX ( leaders, [@r] ), [Total Revenue] )
			RETURN
			    IF (
			        k > 0,
			        names & " Bikes earn " & mText & " margins but only " & FORMAT ( share, "0.0%" ) & " of revenue",
			        "Margins are similar across categories"
			    )
		displayFolder: 6 Titles
		lineageTag: 69dbdf68-235d-53c0-8e0c-f58461c60aa9

	measure 'Title Cancel Trend' =
			
			VAR cur = [Cancelled Line %]
			VAR py = [Cancelled Lines PY]
			VAR chg = ( cur - py ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), "Cancellation rate: " & FORMAT ( cur, "0.0%" ) & " of order lines",
			        ABS ( chg ) < 0.5, "Cancellations held near " & FORMAT ( cur, "0%" ) & " in both years",
			        "Cancellation rate " & IF ( chg > 0, "rose", "fell" ) & " to " & FORMAT ( cur, "0.0%" )
			            & " from " & FORMAT ( py, "0.0%" )
			    )
		displayFolder: 6 Titles
		lineageTag: 5df64690-f581-518e-bdc0-dc15125bab81

	measure 'Cancelled Share of Loss' = DIVIDE ( [Cancelled Value], CALCULATE ( [Cancelled Value], ALLSELECTED ( Sales[Product Name], Sales[Product Category] ) ) )
		formatString: 0.0%
