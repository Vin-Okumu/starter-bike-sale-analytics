	/// Biggest lines = categories with at least 5% of revenue.
	measure 'Title Category Table' =
			
			VAR t =
			    ADDCOLUMNS (
			        FILTER ( VALUES ( Sales[Product Category] ), [Total Revenue] > 0 ),
			        "@s", [Category Revenue Share],
			        "@m", [Gross Margin %]
			    )
			VAR big = FILTER ( t, [@s] >= 0.05 )
			VAR small = FILTER ( t, [@s] < 0.05 )
			VAR n = COUNTROWS ( big )
			VAR lo = MINX ( big, [@m] )
			VAR hi = MAXX ( big, [@m] )
			VAR smallTop = MAXX ( small, [@m] )
			VAR word = SWITCH ( n, 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", n & "" )
			VAR bigText = "The " & word & " big lines all sit at " & FORMAT ( lo * 100, "0" ) & "–" & FORMAT ( hi, "0%" ) & " margin"
			RETURN
			    IF (
			        NOT ISBLANK ( smallTop ) && smallTop > hi,
			        bigText & "; only the small lines reach " & FORMAT ( smallTop, "0%" ),
			        bigText
			    )
		displayFolder: 6 Titles
		lineageTag: 5dfcd593-f1b0-53fa-a537-6e3c67cff368

