	measure 'Title Revenue Trend' =
			VAR py = [Revenue PY]
			VAR chg = [Revenue YoY %]
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@r", [Total Revenue] ), [@r], DESC )
			VAR bestMonth = MAXX ( t, 'Date'[Month] )
			VAR bestValue = MAXX ( t, [@r] )
			VAR m = FILTER ( ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@c", [Total Revenue], "@p", [Revenue PY] ), NOT ISBLANK ( [@c] ) )
			VAR beatAll = COUNTROWS ( m ) > 1 && COUNTROWS ( FILTER ( m, [@c] > [@p] ) ) = COUNTROWS ( m )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), bestMonth & " was the best month in 2022 at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) ) ,
			        beatAll, "Revenue beat " & [Prior Period Label] & " in every month; " & bestMonth & " peaked at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) ),
			        "Revenue " & IF ( chg >= 0, "up ", "down " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs " & [Prior Period Label] & "; " & bestMonth & " was the best month at " & IF ( ABS ( bestValue ) >= 1000, FORMAT ( bestValue / 1000, "$#,0.0" ) & "K", FORMAT ( bestValue, "$#,0" ) )
			    )
		displayFolder: 6 Titles
		lineageTag: e8f60c96-71b3-5de6-8723-682071aa0544

	measure 'Title Category Revenue' =
			VAR c = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Category Share], ALLSELECTED ( Sales[Product Category] ) )
			RETURN c & " earned " & FORMAT ( s, "0%" ) & " of revenue"
		displayFolder: 6 Titles
		lineageTag: 344c64e1-780a-5baa-90d5-6790c77be02e

	measure 'Title Cancellations' =
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Cancel Category Value Share], ALLSELECTED ( Sales[Product Category] ) )
			VAR v = CALCULATE ( [Cancelled Value], ALLSELECTED ( Sales[Product Category] ) )
			RETURN
			    IF (
			        v > 0,
			        c & " caused " & FORMAT ( s, "0%" ) & " of the " & IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) ) & " lost to cancellations",
			        "No order value was lost to cancellations"
			    )
		displayFolder: 6 Titles
		lineageTag: 7d013b00-c41a-5bdc-8f53-3fd8d04c05d3

	measure 'Title Order Status' =
			
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR r = CALCULATE ( [Top Cancel Category Rate], ALLSELECTED ( Sales[Product Category] ) )
			VAR totalLines = CALCULATE ( [Order Lines], ALLSELECTED ( Sales[Product Category] ) )
			VAR bigOthers =
			    FILTER (
			        ALLSELECTED ( Sales[Product Category] ),
			        Sales[Product Category] <> c
			            && DIVIDE ( [Order Lines], totalLines ) >= 0.05
			    )
			VAR otherCancelled = SUMX ( bigOthers, [Total Cancelled Order] )
			RETURN
			    IF (
			        ISBLANK ( c ),
			        "No order lines were cancelled",
			        c & ": " & FORMAT ( r, "0%" ) & " of order lines cancelled"
			            & IF ( otherCancelled = 0, ", while every other big line ships", "" )
			    )
		displayFolder: 6 Titles
		lineageTag: ed3ad67b-51f1-5c3e-b041-5513931992b8

	measure 'Title Top Model' =
			VAR p = [Top Model]
			VAR v = [Top Model Revenue]
			RETURN p & " is the top performing model at " & IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
		displayFolder: 6 Titles
		lineageTag: 790c9861-abdc-5785-8ee8-55dd80bd881f

	measure 'Title PayPal' =
			
			VAR t = ADDCOLUMNS ( ALLSELECTED ( Sales[Payment Method] ), "@a", [Avg Line Value] )
			VAR best = MAXX ( TOPN ( 1, t, [@a], DESC ), Sales[Payment Method] )
			VAR bestV = MAXX ( TOPN ( 1, t, [@a], DESC ), [@a] )
			VAR other = MAXX ( TOPN ( 1, t, [@a], ASC ), Sales[Payment Method] )
			VAR otherV = MAXX ( TOPN ( 1, t, [@a], ASC ), [@a] )
			VAR shortName = SUBSTITUTE ( other, "Credit Card", "card" )
			RETURN
			    best & " order lines are " & FORMAT ( DIVIDE ( bestV - otherV, otherV ), "0%" )
			        & " larger than " & shortName & " lines"
		displayFolder: 6 Titles
		lineageTag: 09b87a2d-bca6-56b5-8143-a149ce37e761

	measure 'Title Processing Value' =
			
			VAR v = [Processing Value]
			VAR s = DIVIDE ( v, [Order Value] )
			RETURN
			    IF (
			        v > 0,
			        IF ( v >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
			            & " (" & FORMAT ( s, "0%" ) & ") of order value is still processing",
			        "All order value has shipped or been cancelled"
			    )
		displayFolder: 6 Titles
		lineageTag: 9b9411f1-a280-5fb4-b200-39e7b0340f3d

	measure 'Title Tax Trend' =
			
			VAR py = [Tax Due PY]
			VAR chg = [Tax Due YoY %]
			VAR v = [Top Tax Month Value]
			VAR m =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@c", [Total Tax Due], "@p", [Tax Due PY] ),
			        NOT ISBLANK ( [@c] )
			    )
			VAR beatAll =
			    COUNTROWS ( m ) > 1
			        && COUNTROWS ( FILTER ( m, [@c] > [@p] ) ) = COUNTROWS ( m )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ),
			            [Top Tax Month] & " had the most tax due at " & FORMAT ( v, "$#,0" ) & " (" & [Current Period Label] & ")",
			        beatAll,
			            "Tax due in " & [Current Period Label] & " was higher than " & [Prior Period Label] & " in every month; "
			                & [Top Tax Month] & " was highest at " & FORMAT ( v, "$#,0" ),
			        "Tax due " & IF ( chg >= 0, "up ", "down " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs "
			            & [Prior Period Label] & "; " & [Top Tax Month] & " was highest at " & FORMAT ( v, "$#,0" )
			    )
		displayFolder: 6 Titles
		lineageTag: aceeb7dd-a833-513a-82af-307e3d417848

	measure 'Title Tax Category' =
			VAR c = CALCULATE ( [Top Tax Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Tax Category Share], ALLSELECTED ( Sales[Product Category] ) )
			RETURN c & " generate " & FORMAT ( s, "0%" ) & " of tax due"
