	/// Text bar drawn with block characters plus the revenue figure at its end; the top category's bar turns blue through [Bar Color Top Category].
	measure 'Revenue Bar Label' =
			
			VAR v = [Total Revenue]
			VAR mx = MAXX ( ALLSELECTED ( Sales[Product Category] ), [Total Revenue] )
			VAR units = 16
			VAR n = IF ( v > 0, MAX ( 1, ROUND ( DIVIDE ( v, mx ) * units, 0 ) ), 0 )
			VAR bar = REPT ( UNICHAR ( 9473 ), n )
			VAR txt = IF ( v >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
			RETURN
			    IF ( ISINSCOPE ( Sales[Product Category] ), bar & "  " & txt, txt )
		displayFolder: 7 Formatting
		lineageTag: 17ef5fcd-aaf0-56ee-a6bd-60d3f7e507cd

	/// Font colour for [Revenue Bar Label]: blue for the top category, grey for the rest.
	measure 'Bar Color Top Category' =
			VAR topC = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Category] ) = topC, "#1D4ED8", "#6B7280" )
