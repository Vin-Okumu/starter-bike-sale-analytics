	measure 'Action Cancellations' =
			
			VAR c = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR v = CALCULATE ( [Cancelled Value], Sales[Product Category] = c )
			VAR n =
			    COUNTROWS (
			        FILTER (
			            VALUES ( Sales[Product Name] ),
			            CALCULATE ( [Cancelled Value], Sales[Product Category] = c ) > 0
			        )
			    )
			VAR recover = v / 2
			RETURN
			    IF (
			        ISBLANK ( c ),
			        "1. No orders were cancelled in this period.",
			        "1. Fix " & c & " cancellations. Check stock, lead times and pricing on the "
			            & n & " models involved. Recovering half the lost value adds about "
			            & IF ( recover >= 1000, FORMAT ( recover / 1000, "$#,0.0" ) & "K", FORMAT ( recover, "$#,0" ) )
			            & " a quarter."
			    )
		displayFolder: 1 Core
		lineageTag: 1b24cbd4-3df7-4ca1-b9a6-011189f55dd9

	measure 'Action Top Category' =
			
			VAR c = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Category Share], ALLSELECTED ( Sales[Product Category] ) )
			RETURN
			    "2. Protect " & c & " stock. It brings in " & FORMAT ( s, "0%" ) & " of revenue."
		displayFolder: 1 Core
		lineageTag: 541f8b18-1378-484b-bb13-2083a5da64fd

	measure 'Action Payment' =
			
			VAR t =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( Sales[Payment Method] ), "@a", [Avg Line Value] ),
			        REMOVEFILTERS ( Sales[Payment Method] )
			    )
			VAR best = MAXX ( TOPN ( 1, t, [@a], DESC ), Sales[Payment Method] )
			VAR bestV = MAXX ( TOPN ( 1, t, [@a], DESC ), [@a] )
			VAR other = MAXX ( TOPN ( 1, t, [@a], ASC ), Sales[Payment Method] )
			VAR otherV = MAXX ( TOPN ( 1, t, [@a], ASC ), [@a] )
			RETURN
			    "3. Feature " & best & " at checkout. Its order lines are "
			        & FORMAT ( DIVIDE ( bestV - otherV, otherV ), "0%" ) & " larger than "
			        & other & " lines (" & FORMAT ( bestV, "$#,0" ) & " vs " & FORMAT ( otherV, "$#,0" ) & ")."
		displayFolder: 1 Core
		lineageTag: 4a7635ec-3107-42b5-9243-d437f41768d0

