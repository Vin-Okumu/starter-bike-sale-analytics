	measure 'Label Payment' =
			
			VAR v = [Avg Line Value]
			VAR t = TOPN ( 1, ADDCOLUMNS ( ALLSELECTED ( Sales[Payment Method] ), "@a", [Avg Line Value] ), [@a], DESC )
			VAR isTop = SELECTEDVALUE ( Sales[Payment Method] ) = MAXX ( t, Sales[Payment Method] )
			RETURN FORMAT ( v, "$#,0" ) & IF ( isTop, " per line", "" )
		displayFolder: 6 Titles
		lineageTag: 8978e0cb-db2a-461f-bcf3-3ec29bda806b

	measure 'Label Color Top Payment' =
			
			VAR t = TOPN ( 1, ADDCOLUMNS ( ALLSELECTED ( Sales[Payment Method] ), "@a", [Avg Line Value] ), [@a], DESC )
			RETURN IF ( SELECTEDVALUE ( Sales[Payment Method] ) = MAXX ( t, Sales[Payment Method] ), "#1D4ED8", "#374151" )
		displayFolder: 7 Formatting
		lineageTag: e608662d-554b-431e-b391-b531c0c2027f

	measure 'Axis Max Payment' =
			
			MAXX ( ALLSELECTED ( Sales[Payment Method] ), [Avg Line Value] ) * 1.4
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: eb0f9185-47ef-461a-bb03-c6838d64677d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Note Payment Mix' =
			
			VAR t =
			    ADDCOLUMNS (
			        ALLSELECTED ( Sales[Payment Method] ),
			        "@lines", [Fulfilled Lines],
			        "@rev", [Total Revenue]
			    )
			VAR used = MAXX ( TOPN ( 1, t, [@lines], DESC ), Sales[Payment Method] )
			VAR usedShare = DIVIDE ( MAXX ( TOPN ( 1, t, [@lines], DESC ), [@lines] ), SUMX ( t, [@lines] ) )
			VAR earner = MAXX ( TOPN ( 1, t, [@rev], DESC ), Sales[Payment Method] )
			VAR earnerRev = MAXX ( TOPN ( 1, t, [@rev], DESC ), [@rev] )
			VAR otherRev = MAXX ( TOPN ( 1, t, [@rev], ASC ), [@rev] )
			VAR fmt1 = IF ( earnerRev >= 1000, FORMAT ( earnerRev / 1000, "$#,0.0" ) & "K", FORMAT ( earnerRev, "$#,0" ) )
			VAR fmt2 = IF ( otherRev >= 1000, FORMAT ( otherRev / 1000, "$#,0.0" ) & "K", FORMAT ( otherRev, "$#,0" ) )
			VAR usedName = SUBSTITUTE ( used, "Credit Card", "Card" )
			RETURN
			    IF (
			        used <> earner,
			        usedName & " is used on " & FORMAT ( usedShare, "0%" ) & " of lines, yet " & earner
			            & " earns more (" & fmt1 & " vs " & fmt2 & ").",
			        usedName & " is used on " & FORMAT ( usedShare, "0%" ) & " of lines and earns the most (" & fmt1 & " vs " & fmt2 & ")."
			    )
		lineageTag: 6c0f3838-7a60-43a9-bd19-8a2e8f1e181d

	/// Subtitle for the order-status bar; names the colours because the legend is off.
	measure 'Subtitle Order Status' =
			"Share of order lines by status, Q1 " & SELECTEDVALUE ( 'Date'[Year] )
			    & ", worst first · dark grey = shipped, light grey = processing, red = cancelled"
		displayFolder: 6 Titles
		lineageTag: 0857115a-b614-4068-b29f-c6c09480cd29

	measure 'Subtitle Cancel Trend' =
			
			VAR cur = [Cancelled Line %]
			VAR py = [Cancelled Lines PY]
			VAR base = "Share of order lines cancelled by month"
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), base,
			        ABS ( ( cur - py ) * 100 ) < 0.5,
			            base & ": a recurring problem · blue = 2023, dashed grey = 2022",
			        base & " · blue = actual selected year, dashed grey = actual prior year"
			    )
		displayFolder: 6 Titles
		lineageTag: 398f6da8-3af1-4b1d-b30c-1bde0d18d040

	measure 'Subtitle Cancelled Models' =
			
			"Cancelled order lines by model, Q1 " & SELECTEDVALUE ( 'Date'[Year] ) & ", largest loss first"
		displayFolder: 6 Titles
		lineageTag: 2767b954-fd77-4f3f-828b-2b01b19a67e8

	measure 'Cancelled Bar Label' =
			
			VAR v = [Cancelled Value]
			VAR mx =
			    MAXX ( ALLSELECTED ( Sales[Product Name], Sales[Product Category] ), [Cancelled Value] )
			VAR units = 16
			VAR n = IF ( v > 0, MAX ( 1, ROUND ( DIVIDE ( v, mx ) * units, 0 ) ), 0 )
			VAR txt = IF ( v >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
			RETURN
			    IF (
			        v > 0,
			        IF ( ISINSCOPE ( Sales[Product Name] ), REPT ( UNICHAR ( 9473 ), n ) & "  " & txt, txt )
			    )
		displayFolder: 7 Formatting
		lineageTag: 058777b1-a7f9-48fb-83b0-18cede95f968

	measure 'Bar Color Cancelled Model' =
			
			VAR topC = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Category] ) = topC, "#B91C1C", "#6B7280" )
		displayFolder: 7 Formatting
		lineageTag: 72a3984d-2fd9-4c49-8679-65561c61ac3c

	measure 'Subtitle Order Value' =
			
			"Order value by status at report date, Q1 " & SELECTEDVALUE ( 'Date'[Year] )
		displayFolder: 6 Titles
		lineageTag: af3c811f-4f38-456d-8679-006ded7abc7d

	measure 'Label Shipped Value' =
			
			VAR v = [Shipped Value]
			RETURN
			    IF ( v >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
			        & " · " & FORMAT ( DIVIDE ( v, [Order Value] ), "0%" )
		displayFolder: 7 Formatting
		lineageTag: 8824d7bc-49a7-4666-b328-e70b916fc695

	measure 'Label Processing Value' =
			
			VAR v = [Processing Value]
			RETURN
			    IF ( v >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) )
			        & " · " & FORMAT ( DIVIDE ( v, [Order Value] ), "0%" )
		displayFolder: 7 Formatting
		lineageTag: 9526454f-e9ab-4aad-91cf-2b9a55fc736b

	/// Invisible 4th segment on the order-status bar; carries the line-count label. The tiny sort key (cancelled lines, then order lines) is too small to see but lets the chart sort Road Bikes first.
	measure 'Label Spacer' =
			VAR sortKey = [Total Cancelled Order] * 1000 + [Order Lines]
			RETURN
			    IF ( NOT ISBLANK ( [Order Lines] ), 0.22 + sortKey / 100000000 )
		displayFolder: 7 Formatting
		lineageTag: 3fc954f5-555c-5168-a493-533ce1deeb75

	/// Label text shown after each order-status bar.
	measure 'Label Line Count' = [Order Lines] & IF ( [Order Lines] = 1, " line", " lines" )
		displayFolder: 7 Formatting
		lineageTag: c77071ce-61c8-5c2f-921e-c64e53c89188

	/// Line-count label colour: red for the category losing most to cancellations.
	measure 'Label Color Line Count' =
			VAR topC = CALCULATE ( [Top Cancel Category], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Category] ) = topC, "#B91C1C", "#6B7280" )
		displayFolder: 7 Formatting
		lineageTag: f35e2bc3-699a-575c-bca0-24854c8ceb38

	measure 'Subtitle Tax Trend' =
			
			VAR base = "Tax due by month, Q1 " & SELECTEDVALUE ( 'Date'[Year] )
			RETURN
			    IF (
			        ISBLANK ( [Tax Due PY] ),
			        base,
			        base & " · blue = Q1 " & SELECTEDVALUE ( 'Date'[Year] ) & ", dashed grey = Q1 " & SELECTEDVALUE ( 'Date'[Year] )-1
			    )
		displayFolder: 6 Titles
		lineageTag: 4e0ab61d-fb9a-44c5-9a78-a7b40edfea0c

	measure 'Current Period Label' =
			VAR y = SELECTEDVALUE ( 'Date'[Year], MAX ( 'Date'[Year] ) )
			RETURN "Q1 " & ( y )
		displayFolder: 2 Comparisons
