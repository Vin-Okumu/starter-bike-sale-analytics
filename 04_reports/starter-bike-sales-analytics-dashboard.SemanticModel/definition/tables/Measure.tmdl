	measure 'KPI Tax Due' =
			VAR v = [Total Tax Due]
			RETURN IF ( ISBLANK ( v ), "–", IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) ) )
		displayFolder: 0 KPI Text
		lineageTag: 33b00263-3ff2-5bff-837c-6dec23015cd3

	measure 'KPI Customer Billings' =
			VAR v = [Customer Billings]
			RETURN IF ( ISBLANK ( v ), "–", IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) ) )
		displayFolder: 0 KPI Text
		lineageTag: 639a4214-46c3-5555-b98f-d96207a403ba

	measure 'KPI Top Model Revenue' =
			VAR v = [Top Model Revenue]
			RETURN IF ( ISBLANK ( v ), "–", IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "$#,0.0" ) & "K", FORMAT ( v, "$#,0" ) ) )
		displayFolder: 0 KPI Text
		lineageTag: eba8d31e-b30b-509e-8f20-b1c7adb917a1

	measure 'KPI PayPal Line Value' = FORMAT ( [PayPal Line Value], "$#,0" )
		displayFolder: 0 KPI Text
		lineageTag: d9a43dae-a523-51b0-8202-de67d6975c21

	measure 'KPI Top Tax Month Value' = FORMAT ( [Top Tax Month Value], "$#,0" )
		displayFolder: 0 KPI Text
		lineageTag: 75167651-4cd1-5186-8a10-64e256001055

	measure 'Top Model Subtitle' =
			VAR p = [Top Model]
			VAR py = [Top Model Revenue PY]
			VAR chg = [Top Model Revenue YoY %]
			RETURN
			    p & IF ( ISBLANK ( py ), "", " · " & IF ( chg >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( chg ), "0%" ) & " vs " & [Prior Period Label] )
		displayFolder: 2 Comparisons
		lineageTag: ba8c3f30-4f5a-5917-a0a8-4278f8e8c2f0

	measure 'Top Tax Month Subtitle' =
			VAR mth = [Top Tax Month]
			VAR py = [Top Tax Month Value PY]
			VAR chg = [Top Tax Month Value YoY %]
			VAR y = SELECTEDVALUE ( 'Date'[Year], MAX ( 'Date'[Year] ) ) - 1
			RETURN
			    mth & IF ( ISBLANK ( py ), "", " · " & IF ( chg >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs " & mth & " " & y & " (" & FORMAT ( py, "$#,0" ) & ")" )
		displayFolder: 2 Comparisons
		lineageTag: fc78f63f-780d-5e61-a2ff-193eaaf301c4

	measure 'Title Margin Leaders' =
			VAR avgM = [Gross Margin %]
			VAR leaders = FILTER ( VALUES ( Sales[Product Category] ), [Total Revenue] > 0 && [Gross Margin %] >= avgM + 0.05 )
			VAR names = CONCATENATEX ( leaders, Sales[Product Category], ", ", [Total Revenue], DESC )
			VAR share = DIVIDE ( SUMX ( leaders, [Total Revenue] ), [Total Revenue] )
			VAR minM = MINX ( leaders, [Gross Margin %] )
			RETURN
			    IF (
			        COUNTROWS ( leaders ) > 0,
			        names & " earn " & FORMAT ( minM, "0%" ) & "+ margins on " & FORMAT ( share, "0.0%" ) & " of revenue",
			        "Margins are similar across categories"
			    )
		displayFolder: 6 Titles
		lineageTag: 69dbdf68-235d-53c0-8e0c-f58461c60aa9

	measure 'Title Cancel Trend' =
			VAR cur = [Cancelled Line %]
			VAR py = [Cancelled Lines PY]
			VAR chg = ( cur - py ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), "Cancellation rate: " & FORMAT ( cur, "0.0%" ),
			        ABS ( chg ) < 0.5, "Cancellations held near " & FORMAT ( cur, "0%" ) & " in both years",
			        "Cancellation rate " & IF ( chg > 0, "rose", "fell" ) & " to " & FORMAT ( cur, "0.0%" ) & " from " & FORMAT ( py, "0.0%" )
			    )
		displayFolder: 6 Titles
		lineageTag: 5df64690-f581-518e-bdc0-dc15125bab81

	measure 'Cancelled Share of Loss' = DIVIDE ( [Cancelled Value], CALCULATE ( [Cancelled Value], ALLSELECTED ( Sales[Product Name], Sales[Product Category] ) ) )
		formatString: 0.0%
		displayFolder: 4 Orders
		lineageTag: d87bd006-4c42-512e-9262-85cbbc35d179

	measure 'Title Cancelled Models' =
			VAR t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( Sales[Product Name] ), "@v", [Cancelled Value] ), [@v] > 0 )
			VAR n = COUNTROWS ( t )
			VAR topP = MAXX ( TOPN ( 1, t, [@v], DESC ), Sales[Product Name] )
			RETURN IF ( n > 0, n & " models account for every cancellation; start with " & topP, "No cancelled orders" )
		displayFolder: 6 Titles
		lineageTag: 648af4a5-5406-55db-9c2b-04c35ad76a61

	measure 'Color Top Payment' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( ALLSELECTED ( Sales[Payment Method] ), "@a", [Avg Line Value] ), [@a], DESC )
			RETURN IF ( SELECTEDVALUE ( Sales[Payment Method] ) = MAXX ( t, Sales[Payment Method] ), "#1D4ED8", "#C3C9D2" )
		displayFolder: 7 Formatting
		lineageTag: 6f7bdd22-4a00-51bc-823c-ca8db42ba2eb

	/// Same as [Total Revenue]; used for the data-bar column in tables.
	measure 'Revenue Bar' = [Total Revenue]
		formatString: \$#,0
		displayFolder: 7 Formatting
		lineageTag: 2b05482e-d786-5e77-9505-27cfa3ed74d9

	/// Same as [Cancelled Value]; used for the data-bar column in tables.
	measure 'Cancelled Value Bar' = [Cancelled Value]
		formatString: \$#,0
		displayFolder: 7 Formatting
		lineageTag: 470b54ed-4ee0-5a39-916a-b78814cd670e

	/// Row background: top revenue category light blue.
	measure 'Bg Top Category' =
			VAR topC = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Category] ) = topC, "#EFF6FF", "#FFFFFF" )
		displayFolder: 7 Formatting
		lineageTag: fb0bdd81-613f-5d24-9dcc-6cb1d1042696

	measure 'Text Top Category' =
			VAR topC = CALCULATE ( [Top Category], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Category] ) = topC, "#1D4ED8", "#374151" )
		displayFolder: 7 Formatting
		lineageTag: 81ccd6c4-f663-5ce5-9410-8fd5851ae873

	measure 'Bg Margin Leaders' =
			VAR avgM = CALCULATE ( [Gross Margin %], ALLSELECTED ( Sales[Product Category] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        HASONEVALUE ( Sales[Product Category] ) && [Gross Margin %] >= avgM + 0.05, "#DBEAFE",
			        [Bg Top Category]
			    )
		displayFolder: 7 Formatting
		lineageTag: 6d77be41-3999-59bb-b248-276302ab0f70

	measure 'Top Cancel Model' =
			VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Sales[Product Name] ), "@v", [Cancelled Value] ), [@v], DESC )
			RETURN IF ( [Cancelled Value] > 0, MAXX ( t, Sales[Product Name] ) )
		displayFolder: 4 Orders
		lineageTag: 98dbd55e-ed2c-505d-b150-5b976647803c

	measure 'Bg Top Cancel Model' =
			VAR topP = CALCULATE ( [Top Cancel Model], ALLSELECTED ( Sales[Product Name], Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Name] ) = topP, "#FEF2F2", "#FFFFFF" )
		displayFolder: 7 Formatting
		lineageTag: d3ddaba2-34bb-52d3-86ce-4f85cda558a6

	measure 'Text Top Cancel Model' =
			VAR topP = CALCULATE ( [Top Cancel Model], ALLSELECTED ( Sales[Product Name], Sales[Product Category] ) )
			RETURN IF ( SELECTEDVALUE ( Sales[Product Name] ) = topP, "#B91C1C", "#374151" )
		displayFolder: 7 Formatting
		lineageTag: c76019d5-b10d-57d3-8c07-089176c76aa2

	measure 'Bg Top Tax Month' =
			VAR topM = CALCULATE ( [Top Tax Month], ALLSELECTED ( 'Date'[Month] ) )
			RETURN IF ( SELECTEDVALUE ( 'Date'[Month] ) = topM, "#EFF6FF", "#FFFFFF" )
		displayFolder: 7 Formatting
		lineageTag: 4b98772f-9e37-5f4b-8a3b-a8acaa9b503f

	measure 'Text Top Tax Month' =
			VAR topM = CALCULATE ( [Top Tax Month], ALLSELECTED ( 'Date'[Month] ) )
			RETURN IF ( SELECTEDVALUE ( 'Date'[Month] ) = topM, "#1D4ED8", "#374151" )
		displayFolder: 7 Formatting
		lineageTag: 55cde627-b762-5f95-a130-27474a38139a

	measure 'Text Margin Leaders' =
			VAR avgM = CALCULATE ( [Gross Margin %], ALLSELECTED ( Sales[Product Category] ) )
			RETURN IF ( HASONEVALUE ( Sales[Product Category] ) && [Gross Margin %] >= avgM + 0.05, "#1D4ED8", [Text Top Category] )
		displayFolder: 7 Formatting
		lineageTag: 1b7e18f8-9d6f-5844-b5ad-2c9e61f5af93

	/// Biggest lines = categories with at least 5% of revenue.
	measure 'Title Category Table' =
			VAR big = FILTER ( VALUES ( Sales[Product Category] ), [Category Revenue Share] >= 0.05 )
			VAR n = COUNTROWS ( big )
			VAR lo = MINX ( big, [Gross Margin %] )
			VAR hi = MAXX ( big, [Gross Margin %] )
			RETURN
			    IF (
			        n > 1,
			        "The " & n & " biggest lines all earn " & FORMAT ( lo, "0%" ) & "–" & FORMAT ( hi, "0%" ) & " margin; " & [Top Category] & " leads revenue",
			        [Top Category] & " leads revenue"
			    )
		displayFolder: 6 Titles
		lineageTag: 5dfcd593-f1b0-53fa-a537-6e3c67cff368

	partition Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measure = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measure", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Measure"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

