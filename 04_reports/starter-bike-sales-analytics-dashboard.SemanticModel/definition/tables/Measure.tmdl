	measure 'Title Tax Trend' =
			VAR py = [Tax Due PY]
			VAR chg = [Tax Due YoY %]
			VAR v = [Top Tax Month Value]
			VAR m = FILTER ( ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@c", [Total Tax Due], "@p", [Tax Due PY] ), NOT ISBLANK ( [@c] ) )
			VAR beatAll = COUNTROWS ( m ) > 1 && COUNTROWS ( FILTER ( m, [@c] > [@p] ) ) = COUNTROWS ( m )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( py ), [Top Tax Month] & " had the most tax due at " & FORMAT ( v, "$#,0" ) & " (no prior-year data to compare)",
			        beatAll, "Tax due was higher than " & [Prior Period Label] & " in every month; " & [Top Tax Month] & " was highest at " & FORMAT ( v, "$#,0" ),
			        "Tax due " & IF ( chg >= 0, "up ", "down " ) & FORMAT ( ABS ( chg ), "0.0%" ) & " vs " & [Prior Period Label] & "; " & [Top Tax Month] & " was highest at " & FORMAT ( v, "$#,0" )
			    )
		displayFolder: 6 Titles
		lineageTag: aceeb7dd-a833-513a-82af-307e3d417848

	measure 'Title Tax Category' =
			VAR c = CALCULATE ( [Top Tax Category], ALLSELECTED ( Sales[Product Category] ) )
			VAR s = CALCULATE ( [Top Tax Category Share], ALLSELECTED ( Sales[Product Category] ) )
			RETURN c & " generate " & FORMAT ( s, "0%" ) & " of tax due"
